# Public (publishable) Supabase configuration for the browser bundle.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets (Never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# QA Accounts (For local development only)
VITE_QA_ROLE=
VITE_QA_ADMIN_USER=admin-placeholder
VITE_QA_SUP_USER=sup-placeholder
VITE_QA_CHW_USER=chw-placeholder
VITE_QA_PASSWORD=your_test_admin_password
QA_PASSWORD=your_test_admin_password
QA_NEW_PASSWORD=your_test_admin_new_password
QA_ADMIN_USER=admin-placeholder
QA_SUP_USER=sup-placeholder
QA_CHW_USER=chw-placeholder
TEST_PASSWORD=your_test_password
